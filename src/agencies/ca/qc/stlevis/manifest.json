  "realtime": {
    "feeds": [
      {
        "kind": "station_departures",
        "format": "json",
        "url": "https://www.stlevis.ca/xhr/gtfs/realtime/times?quantity=3&stop_id={stopId}",
        "pollIntervalSeconds": 60,
        "requestsPerMinute": 48,
        "responseMapping": {
          "routesPath": "$",
          "departuresField": "$",
          "routeIdField": "route_short_name",
          "timeField": "updated_departure_time",
          "scheduledTimeField": "original_departure_time",
