          "directionField": "direction_id",
          "headsignField": "trip_headsign",
          "tripIdField": "trip_id",
          "stopSequenceField": "stop_sequence",
          "delaySecondsField": "delay",
          "realtimeField": "realtime_available",
          "realtimeOnly": true,
          "terminalField": "pickup_type"
        }
      }
    ]
  },
  "alerts": [
    {
      "type": "json",
      "url": "https://www.stlevis.ca/xhr/gtfs/realtime/alerts",
      "parser": "bucketed-transit-alerts",
      "timestampMode": "agency-local-wall-clock",
      "language": "fr"
    }
  ],
  "alertInterpretation": {
    "lineIds": ["L1", "L2", "L3", "22", "23", "L4"],
    "rules": [
      {
        "priority": 50,
        "match": {
          "titleIncludes": ["Travaux", "Fermeture", "Détour", "dévié", "déplacé", "instable"]
        },
        "result": {
          "kind": "delay",
          "severity": "degraded"
        }
      }
    ]
  },
