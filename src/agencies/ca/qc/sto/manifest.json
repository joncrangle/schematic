      "type": "gtfs-rt",
      "format": "protobuf",
      "url": "https://gtfs.sto.ca/download.php?file=alert",
      "auth": {
        "type": "custom",
        "scheme": "sha256-minute",
        "keySecretName": "FEED_STO_API_KEY",
        "secretName": "FEED_STO_API_SECRET",
        "keyParameter": "key",
        "signatureParameter": "hash"
      },
      "pollIntervalSeconds": 60
    },
    {
      "type": "web",
      "parser": "heading-service-notices",
      "url": "https://www.sto.ca/horaires-et-trajets/etat-du-reseau/",
      "language": "fr",
      "cloudflareMaxCrawlPages": 10
    }
  ],
  "alertInterpretation": {
    "lineIds": ["100", "200", "400", "800", "20", "55"],
    "rules": [
      {
        "priority": 50,
        "match": {
          "textIncludes": ["detour", "détour", "arrêts non desservis", "arrêts du Plateau"]
        },
        "result": {
          "kind": "delay",
          "severity": "degraded",
          "serviceChange": "detour"
        }
      }
    ]
  }
