  "realtime": {
    "feeds": [
      {
        "kind": "vehicle_positions",
        "format": "protobuf",
        "url": "https://gtfs.sto.ca/download.php?file=vehicule",
        "auth": {
          "type": "custom",
          "scheme": "sha256-minute",
          "keySecretName": "FEED_STO_API_KEY",
          "secretName": "FEED_STO_API_SECRET",
          "keyParameter": "key",
          "signatureParameter": "hash"
        },
        "pollIntervalSeconds": 60
      },
      {
        "kind": "trip_updates",
        "format": "protobuf",
        "url": "https://gtfs.sto.ca/download.php?file=trip&stream=standard",
        "auth": {
          "type": "custom",
          "scheme": "sha256-minute",
          "keySecretName": "FEED_STO_API_KEY",
          "secretName": "FEED_STO_API_SECRET",
          "keyParameter": "key",
          "signatureParameter": "hash"
        },
        "pollIntervalSeconds": 60,
        "emptyTripUpdates": "error"
      }
    ]
  },
