        "cacheFileName": "yrt-gtfs.zip"
      }
    ],
    "defaultColor": "#004B87",
    "defaultTextColor": "#FFFFFF",
    "source": "seed"
  },
  "realtime": {
    "feeds": [
      {
        "kind": "vehicle_positions",
        "url": "https://rtu.york.ca/gtfsrealtime/VehiclePositions",
        "format": "protobuf",
        "pollIntervalSeconds": 15
      },
      {
        "kind": "trip_updates",
        "url": "https://rtu.york.ca/gtfsrealtime/TripUpdates",
        "format": "protobuf",
        "pollIntervalSeconds": 15
      }
    ]
  },
  "alerts": [
    {
      "type": "web",
      "url": "https://www.yrt.ca/Modules/News/en/serviceadvisories",
      "parser": "ghd-news-service-advisories",
      "runtimes": ["self-hosted"],
      "disabledReason": "Azure Front Door WAF on yrt.ca blocks Cloudflare Workers edge IPs"
    },
    {
      "type": "gtfs-rt",
      "url": "https://alerts.example.com/yrt.pb",
      "devProxyPrefix": "/__dev/upstream/yrt",
      "runtimes": ["cloudflare"],
      "disabledReason": "Requires residential alert proxy daemon (see docs/deployment/deployment-guide.html#proxy)",
      "baseUrlSecretName": "FEED_ALERT_PROXY_BASE_URL",
      "requiredForCompleteness": true,
      "auth": {
        "type": "header",
        "headerName": "x-feed-token",
        "secretName": "FEED_ALERT_PROXY_TOKEN"
      }
    }
  ],
  "scope": "regional",
  "jurisdiction": {
    "country": "ca",
    "region": "on"
  }
