  "popularSurfaceRoutes": ["1", "2", "3M", "8", "9", "10", "15", "17", "11", "12", "13", "16"],
  "alertInterpretation": {
    "lineIds": ["1", "2", "3m", "8", "9", "10", "15", "17"],
    "routeLineMap": { "3M": "3m" },
    "rules": [
      {
        "priority": 300,
        "match": {
          "textIncludes": ["limited service stop"]
        },
        "result": {
          "kind": "information",
          "severity": "normal"
        }
      }
    ]
  },
  "staticTopology": {
    "source": "seed",
    "defaultColor": "#EF4135",
    "defaultTextColor": "#FFFFFF",
    "feeds": [
      {
        "name": "Thunder Bay Transit GTFS",
        "url": "http://api.nextlift.ca/gtfs.zip",
        "cacheFileName": "thunder-bay-gtfs.zip"
      }
    ]
  },
  "realtime": {
    "feeds": [
      {
        "kind": "vehicle_positions",
        "url": "http://api.nextlift.ca/gtfs-realtime/vehicleupdates.pb",
        "format": "protobuf",
        "pollIntervalSeconds": 30,
        "tripDirectionSource": "static"
      },
      {
        "kind": "trip_updates",
        "url": "http://api.nextlift.ca/gtfs-realtime/tripupdates.pb",
        "format": "protobuf",
        "pollIntervalSeconds": 30,
        "tripDirectionSource": "static",
        "cancelledTripsFrom": "http://api.nextlift.ca/gtfs-realtime/alerts.pb"
      }
    ]
  },
  "alerts": [
    {
      "type": "gtfs-rt",
      "url": "http://api.nextlift.ca/gtfs-realtime/alerts.pb",
      "format": "protobuf",
      "emptyIsStale": true
    },
    {
      "type": "web",
      "url": "https://www.thunderbay.ca/city-services/transit/service-alerts/",
      "parser": "ghd-news-service-advisories"
    }
  ]
}
