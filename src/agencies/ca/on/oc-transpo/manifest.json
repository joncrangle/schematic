  "staticTopology": {
    "feeds": [
      {
        "name": "OC Transpo GTFS Schedule",
        "url": "https://oct-gtfs-emasagcnfmcgeham.z01.azurefd.net/public-access/GTFSExport.zip",
        "cacheFileName": "oc-transpo-gtfs.zip"
      }
    ],
    "defaultColor": "#D30F1D",
    "defaultTextColor": "#FFFFFF",
    "source": "seed",
    "routeIdField": "short_name"
  },
  "realtime": {
    "feeds": [
      {
        "kind": "vehicle_positions",
        "url": "https://nextrip-public-api.azure-api.net/octranspo/gtfs-rt-vp/beta/v1/VehiclePositions",
        "format": "protobuf",
        "auth": {
          "type": "header",
          "headerName": "Ocp-Apim-Subscription-Key",
          "secretName": "FEED_OC_TRANSPO_API_KEY"
        },
        "pollIntervalSeconds": 30,
        "devProxyPrefix": "/__dev/upstream/oc-transpo"
      },
      {
        "kind": "trip_updates",
        "url": "https://nextrip-public-api.azure-api.net/octranspo/gtfs-rt-tp/beta/v1/TripUpdates",
        "format": "protobuf",
        "auth": {
          "type": "header",
          "headerName": "Ocp-Apim-Subscription-Key",
          "secretName": "FEED_OC_TRANSPO_API_KEY"
        },
        "pollIntervalSeconds": 30,
        "devProxyPrefix": "/__dev/upstream/oc-transpo"
      }
    ]
  },
