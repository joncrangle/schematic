  "alertInterpretation": {
    "lineIds": ["90", "91", "92", "93", "94", "95", "17", "36"],
    "rules": [
      {
        "priority": 100,
        "match": {
          "titleIncludes": ["STOP CLOSURE"]
        },
        "result": {
          "kind": "information",
          "severity": "degraded"
        }
      },
      {
        "priority": 90,
        "match": {
          "titleIncludes": ["DETOUR"]
        },
        "result": {
          "kind": "delay",
          "severity": "degraded",
          "serviceChange": "detour"
        }
      }
    ]
  },
  "staticTopology": {
    "source": "seed",
    "feeds": [
      {
        "name": "London Transit GTFS",
        "url": "https://www.londontransit.ca/gtfsfeed/google_transit.zip",
        "cacheFileName": "ltc-gtfs.zip"
      }
    ]
  },
  "realtime": {
    "feeds": [
      {
        "kind": "vehicle_positions",
        "url": "http://gtfs.ltconline.ca/Vehicle/VehiclePositions.pb",
        "format": "protobuf",
        "pollIntervalSeconds": 30,
        "accept": "*/*"
      },
      {
        "kind": "trip_updates",
        "url": "http://gtfs.ltconline.ca/TripUpdate/TripUpdates.pb",
        "format": "protobuf",
        "pollIntervalSeconds": 60,
        "accept": "*/*"
      }
    ]
  },
  "alerts": [
    {
      "type": "gtfs-rt",
      "url": "http://gtfs.ltconline.ca/Alert/Alerts.pb",
      "format": "protobuf",
      "accept": "*/*"
    }
  ]
