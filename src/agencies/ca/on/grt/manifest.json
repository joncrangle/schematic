  "popularSurfaceRoutes": ["302", "201", "202", "51", "8"],
  "routeInterpretation": {
    "routeTypeRules": [{ "routeType": "rail", "routeIds": ["301"] }]
  },
  "staticTopology": {
    "feeds": [
      {
        "name": "GRT Bus",
        "url": "https://webapps.regionofwaterloo.ca/api/grt-routes/api/staticfeeds/1",
        "cacheFileName": "grt-bus-gtfs.zip"
      },
      {
        "name": "ION Light Rail",
        "url": "https://webapps.regionofwaterloo.ca/api/grt-routes/api/staticfeeds/2",
        "cacheFileName": "grt-ion-gtfs.zip"
      }
    ],
    "defaultColor": "#006BB7",
    "defaultTextColor": "#FFFFFF",
    "source": "seed"
  },
  "realtime": {
    "feeds": [
      {
        "kind": "vehicle_positions",
        "url": "https://webapps.regionofwaterloo.ca/api/grt-routes/api/vehiclepositions/1",
        "format": "protobuf",
        "unreliableVehicleFields": ["speed"],
        "devProxyPrefix": "/__dev/upstream/grt",
        "pollIntervalSeconds": 15
      },
      {
        "kind": "trip_updates",
        "url": "https://webapps.regionofwaterloo.ca/api/grt-routes/api/tripupdates/1",
        "format": "protobuf",
        "devProxyPrefix": "/__dev/upstream/grt",
        "pollIntervalSeconds": 15
      },
      {
        "kind": "vehicle_positions",
        "url": "https://webapps.regionofwaterloo.ca/api/grt-routes/api/vehiclepositions/2",
        "format": "protobuf",
        "unreliableVehicleFields": ["speed"],
        "devProxyPrefix": "/__dev/upstream/grt",
        "pollIntervalSeconds": 15
      },
      {
        "kind": "station_trip_updates",
        "url": "https://webapps.regionofwaterloo.ca/api/grt-routes/api/tripupdates/1",
        "format": "protobuf",
        "devProxyPrefix": "/__dev/upstream/grt",
        "pollIntervalSeconds": 15
      },
      {
        "kind": "station_trip_updates",
        "url": "https://webapps.regionofwaterloo.ca/api/grt-routes/api/tripupdates/2",
        "format": "protobuf",
        "devProxyPrefix": "/__dev/upstream/grt",
        "pollIntervalSeconds": 15
      }
    ]
  },
  "alerts": [
    {
      "type": "gtfs-rt",
      "url": "https://webapps.regionofwaterloo.ca/api/grt-routes/api/alerts",
      "devProxyPrefix": "/__dev/upstream/grt"
    },
    {
      "type": "web",
      "url": "https://www.grt.ca/alerts-and-detours/",
      "parser": "ghd-news-service-advisories",
      "maxAgeMinutes": 20160,
      "runtimes": ["self-hosted"]
    },
    {
      "type": "gtfs-rt",
      "url": "https://alerts.example.com/grt.pb",
      "format": "protobuf",
      "runtimes": ["cloudflare"],
      "disabledReason": "Requires the alert-feed daemon and FEED_ALERT_PROXY_BASE_URL/FEED_ALERT_PROXY_TOKEN secrets (see docs/deployment/deployment-guide.html#proxy)",
      "baseUrlSecretName": "FEED_ALERT_PROXY_BASE_URL",
      "requiredForCompleteness": true,
      "auth": {
        "type": "header",
        "headerName": "x-feed-token",
        "secretName": "FEED_ALERT_PROXY_TOKEN"
      }
    }
  ],
  "scope": "regional",
  "jurisdiction": {
    "country": "ca",
    "region": "on"
  }
}
