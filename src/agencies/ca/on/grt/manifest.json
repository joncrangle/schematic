{
  "id": "grt",
  "name": "Grand River Transit",
  "serviceArea": "Waterloo Region",
  "serviceAreaTranslations": { "fr": "Région de Waterloo" },
  "shortName": "GRT",
  "brandColor": "#006BB7",
  "locale": "en-CA",
  "timezone": "America/Toronto",
  "bounds": [
    { "minLat": 43.37, "maxLat": 43.51, "minLon": -80.6, "maxLon": -80.435 },
    { "minLat": 43.33, "maxLat": 43.48, "minLon": -80.44, "maxLon": -80.27 },
    { "minLat": 43.505, "maxLat": 43.61, "minLon": -80.6, "maxLon": -80.49 },
    { "minLat": 43.365, "maxLat": 43.43, "minLon": -80.72, "maxLon": -80.6 }
  ],
  "modes": ["rail", "bus"],
  "proximity": {
    "radiusMeters": 1500,
    "bucketMeters": 75
  },
  "stationService": [{ "routeType": "rail" }, { "routeType": "bus" }],
  "attribution": {
    "name": "Grand River Transit / The Regional Municipality of Waterloo open data",
    "url": "https://www.grt.ca/about-grt/open-data",
    "license": "Contains information provided by the Regional Municipality of Waterloo under licence",
    "licenseIsStatement": true
  },
  "status": "experimental",
  "alertInterpretation": {
    "lineIds": ["ion", "ion-bus", "51", "8", "201", "202"],
    "routeLineMap": {
      "301": "ion",
      "302": "ion-bus"
    },
    "rules": [
      {
        "priority": 150,
        "match": {
          "textIncludes": ["emergency detour", "emergency"]
        },
        "result": {
          "kind": "delay",
          "severity": "degraded",
          "serviceChange": "detour"
        }
      }
    ]
  },
  "cityPresets": [
