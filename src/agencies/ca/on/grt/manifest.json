      "lon": -80.313253
    },
    {
      "name": "University of Waterloo Station",
      "lat": 43.473404,
      "lon": -80.541294
    },
    {
      "name": "Cambridge Centre Station",
      "lat": 43.392657,
      "lon": -80.322665
    }
