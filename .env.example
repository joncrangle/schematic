# =====================================================================
# Schematic — Environment Configuration Template
# =====================================================================
# Copy this file to `.env` for local development.

# Server Configuration
PORT=3000

# HTTPS / SSL Local Development (default: false)
# Dev server runs with plain HTTP by default for local and LAN development.
# Set to true to opt-in to self-signed HTTPS (or run `bun run dev:https`).
VITE_HTTPS=false

# Log Level (debug, info, warn, error)
VITE_LOG_LEVEL=info
# Runtime log level honored by the server logger (overrides VITE_LOG_LEVEL);
# under Cloudflare Workers this comes from wrangler.jsonc vars.LOG_LEVEL.
# LOG_LEVEL=info

# SQLite Database Storage Directory (for self-hosting Bun/Node runtime & GTFS seeding)
# Transit topology (transit.db) and push notifications (push-notifications.db)
# are stored in this directory.
DATA_DIR=./data

# GeoLite2-City mmdb path enabling the coarse-ip location tier (optional).
# When unset or unreadable the tier stays disabled (silent degrade).
# GEOIP_DB_PATH=./GeoLite2-City.mmdb

# Web Push Notification Service (VAPID) — For commute disruption alerts
# Generate a new keypair with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional comma-separated exact HTTPS hostnames for a self-hosted push service.
# PUSH_ENDPOINT_HOSTS=push.example.net

# Optional push registration bounds (defaults shown). New subscriptions per
# client network per window, the instance-wide subscription ceiling, and how
# long a never-delivered subscription is kept. Self-hosted limits key on the
# last X-Forwarded-For hop, so run a reverse proxy that appends it.
# PUSH_REGISTRATION_LIMIT=10
# PUSH_REGISTRATION_WINDOW_MINUTES=60
# PUSH_SUBSCRIPTION_CEILING=50000
# PUSH_UNDELIVERED_RETENTION_DAYS=30

# Agency Feed Secrets (optional)

# Metrolinx GTFS-RT API Key for GO Transit live feeds (https://www.gotransit.com/en/partner-with-us/software-developers)
# FEED_METROLINX_API_KEY=

# OC Transpo GTFS-RT subscription key (https://www.octranspo.com/en/plan-your-trip/travel-tools/developers/dev-doc)
# Sent as the `Ocp-Apim-Subscription-Key` header.
# FEED_OC_TRANSPO_API_KEY=

# STM GTFS-RT and i3 API Hub key (https://portail.developpeurs.stm.info/apihub/)
# FEED_STM_API_KEY=

# chrono-saeiv GTFS-RT key (https://portail-developpeur.chrono-saeiv.com/signup)
# FEED_CHRONO_API_KEY=

# STO GTFS-RT public identifier and private signing secret (https://gtfs.sto.ca/index.php)
# FEED_STO_API_KEY=
# FEED_STO_API_SECRET=

# TransLink GTFS-RT key (https://developer.translink.ca/account/register)
# FEED_TRANSLINK_API_KEY=

# Winnipeg Transit live departures and advisories (query parameter `api-key`).
# Register for a free key at https://api.winnipegtransit.com/home/users/new.
# FEED_WINNIPEG_TRANSIT_API_KEY=

# T3 Transit city departures and vehicle tracking via Swiftly (Authorization header).
# Use the city rider app credential from https://live.goswift.ly/ca-t3-transit.
# Rural vehicle tracking needs no key; T3 has no live alert source.
# FEED_T3_SWIFTLY_TOKEN=

# Tidal Transit live departures and vehicle tracking via TransLoc (query parameter `apiKey`).
# No public registration page is documented; the key is issued for the operator's
# TransLoc rider site (https://kbus.transloc.com/).
# FEED_TIDAL_API_KEY=

# Optional alert proxy (services/alert-feed-daemon) for agencies whose alert pages
# block cloud hosts. The base URL is the daemon's HTTPS origin; the token is the
# same FEED_ALERT_PROXY_TOKEN the daemon is started with (sent as `x-feed-token`).
# FEED_ALERT_PROXY_BASE_URL=
# FEED_ALERT_PROXY_TOKEN=
