{
  "name": "schematic",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:https": "VITE_HTTPS=true vite dev",
    "lint": "oxlint src && bun run lint:tests",
    "lint:tests": "oxlint --vitest-plugin --allow all --deny vitest/no-conditional-expect tests",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "setup": "bun install",
    "build:sw": "bun scripts/build-service-worker.ts",
    "build": "bun scripts/build-service-worker.ts && vite build",
    "start": "bun scripts/start-server.ts",
    "preview": "vite preview",
    "deploy": "bun run deploy:check && bun run build && bun run check:worker-functions && wrangler deploy",
    "deploy:check": "bun scripts/check-deploy-readiness.ts && bun run alerts:index:check && bun scripts/check-schedule-assets.ts",
    "alerts:index": "bun scripts/generate-alert-identities.ts",
    "alerts:index:check": "bun scripts/generate-alert-identities.ts --check",
    "check:worker-functions": "bun scripts/check-built-server-functions.ts",
    "agency:check": "bun scripts/check-agency.ts",
    "seed": "bun scripts/seed.ts",
    "seed:interchanges": "bun scripts/seed.ts --interchange-only",
    "alerts:spoof": "bun scripts/spoof-alert.ts",
    "alerts:dev": "PORT=3001 cargo run -p alert-feed-daemon",
    "alerts:build": "cargo build --release -p alert-feed-daemon",
    "alerts:start": "PORT=3001 ./target/release/alert-feed-daemon",
    "alerts:test": "cargo test -p alert-feed-daemon",
    "alerts:check": "cargo check -p alert-feed-daemon",
    "alerts:inspect": "curl -s http://localhost:3001/yrt.pb | protoc --decode=transit_realtime.FeedMessage proto/gtfs-realtime.proto",
    "docs:check": "bun scripts/check-agent-docs.ts",
    "attribution:generate": "bun scripts/generate-data-attribution.ts",
    "attribution:check": "bun scripts/generate-data-attribution.ts --check",
    "coverage:geography": "bun scripts/generate-coverage-geography.ts",
    "coverage:geography:check": "bun scripts/generate-coverage-geography.ts --check",
    "bench:coverage": "bun scripts/bench-coverage-map.ts",
    "notifications:diagnose": "bun scripts/diagnose-notifications.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.44",
    "@solidjs/web": "2.0.0-rc.21",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/solid-query": "6.0.0-rc.5",
    "clsx": "^2.1.1",
    "effect": "^4.1.2",
    "entities": "9.0.0",
    "fast-xml-parser": "^5.12.0",
    "mmdb-lib": "^3.0.4",
    "parse5": "^8.1.0",
    "solid-js": "2.0.0-rc.21",
    "string-width": "^8.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.92.0",
    "playwright-core": "1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
