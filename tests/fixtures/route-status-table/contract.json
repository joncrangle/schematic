{
  "cases": [
    {
      "name": "clears routes with normal-service wording, including a misspelling",
      "html": "<main><h2>Commuter routes</h2><table><tbody><tr><td><p><strong>Route</strong></p></td><td><p><strong>Disruptions</strong></p></td></tr><tr><td><p>10</p></td><td><p>No anticipated disruptions</p></td></tr><tr><td><p>10S</p></td><td><p>No antisipated disruptions.</p></td></tr><tr><td><p>On-demand Transit</p></td><td><p><strong>All stops are currently open</strong><br><br></p></td></tr></tbody></table></main>",
      "routeNames": {
        "10": [
          "10"
        ],
        "10S": [
          "10S"
        ]
      },
      "notices": []
    },
    {
      "name": "keeps a route notice and a systemwide notice as published",
      "html": "<main><table><tbody><tr><td><p><strong>Route</strong></p></td><td><p><strong>Disruptions</strong></p></td></tr><tr><td><p>All routes</p></td><td><p>Construction may slow any route.</p></td></tr><tr><td><p>10</p></td><td><p>Detour on Elm Street.<br>Use stop 1234.</p></td></tr><tr><td><p>12</p></td><td><p>No anticipated disruptions</p></td></tr></tbody></table></main>",
      "routeNames": {
        "10": [
          "10"
        ],
        "12": [
          "12"
        ]
      },
      "notices": [
        {
          "id": "https://example.test/status#All routes",
          "title": "All routes",
          "description": "Construction may slow any route.",
          "routeIds": []
        },
        {
          "id": "https://example.test/status#10",
          "title": "Route 10",
          "description": "Detour on Elm Street. Use stop 1234.",
          "routeIds": [
            "10"
          ]
        }
      ]
    },
    {
      "name": "maps a label to every route sharing that alias",
