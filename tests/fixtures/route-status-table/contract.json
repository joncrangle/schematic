      "routeNames": {
        "20A": [
          "20"
        ],
        "20B": [
          "20"
        ]
      },
      "notices": [
        {
          "id": "https://example.test/status#20",
          "title": "Route 20",
          "description": "Stop 55 is closed.",
          "routeIds": [
            "20A",
            "20B"
          ]
        }
      ]
    },
    {
      "name": "withholds an unmapped route notice and reports the read partial",
      "html": "<table><tbody><tr><td><p><strong>Route</strong></p></td><td><p><strong>Disruptions</strong></p></td></tr><tr><td><p>99</p></td><td><p>Detour on Oak Avenue.</p></td></tr><tr><td><p>10</p></td><td><p>No anticipated disruptions</p></td></tr></tbody></table>",
      "routeNames": {
        "10": [
          "10"
        ]
      },
      "partial": true,
      "notices": []
    },
    {
      "name": "merges repeated rows for one route",
      "html": "<table><tbody><tr><td><p><strong>Routes</strong></p></td><td><p><strong>Disruptions</strong></p></td></tr><tr><td><p>10</p></td><td><p>Detour on Elm Street.</p></td></tr></tbody></table><table><tbody><tr><td><p><strong>Route</strong></p></td><td><p><strong>Disruptions</strong></p></td></tr><tr><td><p>10</p></td><td><p>Stop 77 is closed.</p></td></tr></tbody></table>",
      "routeNames": {
        "10": [
          "10"
        ]
      },
      "notices": [
